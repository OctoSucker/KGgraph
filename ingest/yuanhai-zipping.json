 "evidence": [
  {
   "edge_id": 1,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/yuanhai-zipping/十神基础",
   "snippet": "以甲为例见甲：为比肩、兄弟。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 3,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/yuanhai-zipping/十神基础",
   "snippet": "以甲为例见乙：为劫财、败财，剋父及妻。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 5,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/yuanhai-zipping/十神基础",
   "snippet": "以甲为例见丙：为食神、天厨、寿星，为男。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 7,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/yuanhai-zipping/十神基础",
   "snippet": "以甲为例见丁：为伤官、退财、耗气，子甥。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 9,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/yuanhai-zipping/十神基础",
   "snippet": "以甲为例见戊：为偏财、偏妻、偏妾，剋子。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 11,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/yuanhai-zipping/十神基础",
   "snippet": "以甲为例见己：为正财、正妻，剋母，为合神。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 13,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/yuanhai-zipping/十神基础",
   "snippet": "以甲为例见庚：为偏官、七杀、官鬼、将星。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 15,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/yuanhai-zipping/十神基础",
   "snippet": "以甲为例见辛：为正官、禄马、荣神，父母。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 17,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/yuanhai-zipping/十神基础",
   "snippet": "以甲为例见壬：为倒食、偏印、梟神，剋女。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 19,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/yuanhai-zipping/十神基础",
   "snippet": "以甲为例见癸：为印綬、正人、君子，产业。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 21,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/yuanhai-zipping/择日三要",
   "snippet": "以干为天，以支为地，支中所藏者为人元。乃分四柱，以年为根，月为苗，日为花，时为果。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 22,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/yuanhai-zipping/大运",
   "snippet": "子平之法，大运看支，岁君看干，交运同接木。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 23,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/yuanhai-zipping/继善篇",
   "snippet": "欲知贵贱，先观月令乃提纲，次断吉凶。专用日干为主本；三元要成格局，四柱喜见财官。用神不可损伤。日主最宜健旺。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 24,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/yuanhai-zipping/六亲",
   "snippet": "正印正母；偏印偏母及祖父也。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 25,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/yuanhai-zipping/六亲",
   "snippet": "正印正母；偏印偏母及祖父也。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 26,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/yuanhai-zipping/六亲",
   "snippet": "偏财是父，乃母之夫星也，亦为偏妻。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 27,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/yuanhai-zipping/六亲",
   "snippet": "正财为妻；偏财为妾，为父是也。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 28,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/yuanhai-zipping/六亲",
   "snippet": "比肩为兄弟姐妹也。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 29,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/yuanhai-zipping/六亲",
   "snippet": "七杀是男。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 30,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/yuanhai-zipping/六亲",
   "snippet": "正官是女。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 31,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/yuanhai-zipping/六亲",
   "snippet": "食神是男孙。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 32,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/yuanhai-zipping/六亲",
   "snippet": "伤官是女孙及祖母也。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 33,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/yuanhai-zipping/格局",
   "snippet": "官星须得印绶、身旺则发；若无伤官破印，身不弱者便为贵命。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 34,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/yuanhai-zipping/格局",
   "snippet": "人有偏官，如抱虎而眠，虽借其威，足以摄群畜；稍失关防，必为其噬脐。如遇三刑俱全、阳刃在日及时、又有六害；复遇魁罡相冲，凶不可述。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 35,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/yuanhai-zipping/格局",
   "snippet": "日德有五：甲寅、戊辰、丙辰、庚辰、壬戌日是也。其福要多，而忌刑冲破害，恶官星，憎财旺；加临会合，但空亡而忌魁罡。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 36,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/yuanhai-zipping/格局",
   "snippet": "夫魁罡者有四：壬辰、庚戌、戊戌、庚辰日是也；如日位加临者众，必是福。主人性格聪明、文章振发、临事有断，惟是好杀。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 37,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/yuanhai-zipping/格局",
   "snippet": "天元一气，羸弱贫薄难治。是乐于身旺，不要行剋制之乡；剋制者，官鬼也。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 38,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/yuanhai-zipping/格局",
   "snippet": "柱中官星太旺，天元羸弱之名。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 39,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/yuanhai-zipping/格局",
   "snippet": "天元虽旺，若无依倚是常人。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 40,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/yuanhai-zipping/格局",
   "snippet": "女命用官为夫、或杀；只喜一位，多者剋夫。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 41,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/yuanhai-zipping/神煞",
   "snippet": "太岁乃众杀之主，入命未必为灾；若遇战斗之乡，必主刑于本命。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 42,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/yuanhai-zipping/神煞",
   "snippet": "阳刃桃花、伏吟返吟、休、囚、死、绝、衰、败者凶。遇帝旺、临官、禄马、贵人、生、养、冠带、库者吉。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 43,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/yuanhai-zipping/歌诀",
   "snippet": "人稟天地，命属阴阳，生居覆载之内，尽在五行之中。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 44,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/yuanhai-zipping/歌诀",
   "snippet": "专用日干为主本；三元要成格局，四柱喜见财官。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 45,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/yuanhai-zipping/歌诀",
   "snippet": "官禄贵马见合刑，一举便成名。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 46,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/yuanhai-zipping/歌诀",
   "snippet": "官星愷悌，贵气轩昂，性优游而仁慈宽大。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 47,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/yuanhai-zipping/歌诀",
   "snippet": "印綬主多智慧、丰身自在心慈。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 48,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/yuanhai-zipping/歌诀",
   "snippet": "人命荣枯得失，尽在五行生剋之中；富贵贫穷，不出乎八字中和之外。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 49,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/yuanhai-zipping/歌诀",
   "snippet": "先观气节之浅深，后看财官之向背。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 50,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/yuanhai-zipping/歌诀",
   "snippet": "辰戌丑未，四土之神。人元三用，透旺爲真。寅申巳亥，四生之局。用物身強，遇之發福。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 51,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/yuanhai-zipping/歌诀",
   "snippet": "天元一氣，地物相同。人命得此，位列三公。",
   "supports": true,
   "weight": 1.0
  }
 ]
}
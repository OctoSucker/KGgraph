 "evidence": [
  {
   "edge_id": 1,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/ziping-zhenquan/论用神",
   "snippet": "八字用神，專求月令，以日乾配月令地支，而生克不同，格局分焉。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 2,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/ziping-zhenquan/论用神",
   "snippet": "財官印食，此用神之善而順用之者也；煞傷劫刃，用神之不善而逆用之者也。當順而順，當逆而逆，配合得宜，皆為貴格。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 3,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/ziping-zhenquan/论用神",
   "snippet": "日元強者抑之，日元弱者扶之，此以扶抑為用神也。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 4,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/ziping-zhenquan/论用神",
   "snippet": "以扶為喜，則以傷其扶者為病；以抑為喜，則以去其抑者為病。除其病神，即謂之藥。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 5,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/ziping-zhenquan/论用神",
   "snippet": "金水生於冬令，木火生於夏令，氣候太寒太燥，以調和氣候為急。此以調候為用神也。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 6,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/ziping-zhenquan/论用神",
   "snippet": "木生寅卯，日與月同，本身不可為用，必看四柱有無財官煞食透幹會支，另取用神；然終以月令為主。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 7,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/ziping-zhenquan/论用神",
   "snippet": "十干不論月令休囚，只要四柱有根，便能受財官食神而當傷官七煞。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 8,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/ziping-zhenquan/论用神",
   "snippet": "長生祿旺，根之重者也；墓庫餘氣，根之輕者也。天乾得一比肩，不如得支中一墓庫。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 9,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/ziping-zhenquan/论用神",
   "snippet": "人之日主，不必生逢祿旺，即月令休囚，而年日時中得長祿旺，便不為弱，就使逢庫，亦為有根。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 10,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/ziping-zhenquan/论用神",
   "snippet": "刑衝俱不為美，而刑衝用神，尤為破格，不如以另位之刑衝，解月令之刑衝。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 11,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/ziping-zhenquan/论用神",
   "snippet": "用神之情，不向日主，或日主之情，不向用神，皆非美朕也。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 12,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/ziping-zhenquan/论用神",
   "snippet": "四吉神能破格（财官印食顺用，逢忌神则破）。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 13,

  {
   "edge_id": 33,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/meihua-yishu/卷一",
   "snippet": "震、巽木旺於春，離火旺于夏，乾、兌金旺於秋，坎水旺於冬，坤、艮土旺於辰戌丑未月。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 37,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/meihua-yishu/卷二",
   "snippet": "應用生及比和，則吉；體生用及克體，則不吉。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 38,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/meihua-yishu/卷二",
   "snippet": "體生用有耗失之患。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 39,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/meihua-yishu/卷二",
   "snippet": "用克體不宜，體克用則吉。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 40,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/meihua-yishu/卷二",
   "snippet": "體克用則吉。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 41,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/meihua-yishu/卷二",
   "snippet": "體用比和，謀為吉利。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 42,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/meihua-yishu/卷二",
   "snippet": "大抵占卜之法，成卦之後先看《周易》爻辭，以斷吉凶。次看卦之體用，以論五行生克。又次看克應。複驗己身之動靜。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 43,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/meihua-yishu/卷二",
   "snippet": "如聞吉說見吉兆，則吉；聞凶說見凶兆，則凶。見圓物，事易成；見缺物，事終毀之類。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 44,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/meihua-yishu/卷一",
   "snippet": "凡起卦不問數多少，即以此數作卦數，過八數即以八數遞除。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 45,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/meihua-yishu/卷一",
   "snippet": "爻以六除。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 46,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/meihua-yishu/卷一",
   "snippet": "年月日時起例。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 48,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/meihua-yishu/卷二",
   "snippet": "先天卦斷吉凶，止以卦論，不甚用《易》之爻辭。後天則用爻辭，兼用卦辭。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 49,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/meihua-yishu/卷二",
   "snippet": "後天起卦定爻必加時而後可。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 50,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/meihua-yishu/卷二",
   "snippet": "離多主晴，坎多主雨，坤乃陰晦，乾主晴明，震多則春夏雷轟，巽多則四時風烈，艮多則久雨必晴，兌多則不雨亦陰。",
   "supports": true,
   "weight": 1.0
  }
 ]

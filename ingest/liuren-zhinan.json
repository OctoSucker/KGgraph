 "evidence": [
  {
   "edge_id": 2,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/liuren-zhinan/卷一",
   "snippet": "六壬如人，先明日辰。日尊故曰天干，辰卑故曰地支。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 3,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/liuren-zhinan/卷一",
   "snippet": "以月將加占時之上，順布十二宮辰，即天盤也。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 4,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/liuren-zhinan/卷一",
   "snippet": "正月雨水後日躔娵訾之次入亥宮，乃登明將也。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 6,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/liuren-zhinan/卷一",
   "snippet": "二月春分後日躔降婁之次入戌宮，乃河魁將也。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 8,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/liuren-zhinan/卷一",
   "snippet": "三月穀雨後日躔大梁之次入酉宮，乃從魁將也。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 10,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/liuren-zhinan/卷一",
   "snippet": "四月小滿後日躔實沈之次入申宮，乃傳送將也。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 12,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/liuren-zhinan/卷一",
   "snippet": "五月夏至後日躔鶉首之次入未宮，乃小吉將也。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 14,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/liuren-zhinan/卷一",
   "snippet": "六月大暑後日躔鶉火之次入午宮，乃勝光將也。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 16,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/liuren-zhinan/卷一",
   "snippet": "七月處暑後日躔鶉尾之次入巳宮，乃太乙將也。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 18,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/liuren-zhinan/卷一",
   "snippet": "八月秋分後日躔壽星之次入辰宮，乃天罡將也。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 20,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/liuren-zhinan/卷一",
   "snippet": "九月霜降後日躔大火之次入卯宮，乃太沖將也。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 22,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/liuren-zhinan/卷一",
   "snippet": "十月小雪後日躔析木之次入寅宮，乃功曹將也。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 24,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/liuren-zhinan/卷一",
   "snippet": "十一月冬至後日躔星紀之次入丑宮，乃大吉將也。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 26,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/liuren-zhinan/卷一",
   "snippet": "十二月大寒後日躔玄枵之次入子宮，乃神後將也。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 28,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/liuren-zhinan/卷一",
   "snippet": "干上陽神為第一課，乃陽中之陽也；干上陰神為第二課，乃陽中之陰也；支上陽神為第三課，乃陰中之陽也；支上陰神為第四課，乃陰中之陰也。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 29,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/liuren-zhinan/卷一",
   "snippet": "若四課中並無下克，唯一上神克下，取而用之名曰元首課。上克為元首，理順成而百事咸宜。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 30,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/liuren-zhinan/卷一",
   "snippet": "若有一下克其上神者，雖有二三之上克下不論矣，名曰重審課。下賊為重審，人事逆而謀為不利。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 31,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/liuren-zhinan/卷一",
   "snippet": "二三克賊，知一總名。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 32,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/liuren-zhinan/卷一",
   "snippet": "用孟名曰見機，當因時以致宜。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 33,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/liuren-zhinan/卷一",
   "snippet": "仲季號為察微，事未萌而預計。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 34,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/liuren-zhinan/卷一",
   "snippet": "克賊重重比涉害，用辰主外灾害己，用日主我禍延人。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 35,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/liuren-zhinan/卷一",
   "snippet": "蒿矢神遙克日，二克主兩事而合為一事。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 36,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/liuren-zhinan/卷一",
   "snippet": "彈射日遙克神，一克主一端而分作兩端。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 37,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/liuren-zhinan/卷一",
   "snippet": "昴星如虎對立，視俯仰以定遠近之憂危。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 38,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/liuren-zhinan/卷二",
   "snippet": "六壬通萬變之機，大為國而小為家。日辰定動靜之位，日為人而辰為事。",
   "supports": true,
   "weight": 1.0
  }
 ]
}
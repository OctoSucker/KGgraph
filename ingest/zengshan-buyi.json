 "evidence": [
  {
   "edge_id": 1,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/zengshan-buyi/第十章",
   "snippet": "元神生用神，須要旺相，方可生得用神。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 2,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/zengshan-buyi/第十章",
   "snippet": "忌神動而克害用神。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 3,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/zengshan-buyi/第十章",
   "snippet": "忌神與仇神同動五也。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 4,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/zengshan-buyi/第十章",
   "snippet": "元神能生用神者有五：元神旺相或臨日月或日月動爻生扶者一也。元神動化回頭生及化進神者二也。元神長生帝旺於日辰三也。元神與忌神同動四也。元神旺動臨空化空五也。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 5,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/zengshan-buyi/第十章",
   "snippet": "元神又有不能生用神者有六：元神休囚，不動或動而休囚又被傷克者一也。元神休囚又逢自空、月破二也。元神休囚動化退神三也。元神衰而又絕四也。元神入三墓五也。元神休囚動而化絕、化克、化破、化散六也。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 6,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/zengshan-buyi/第十章",
   "snippet": "忌神動而克害用神者有五。以上之忌神者如斧戟之忌神，諸占大凶。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 7,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/zengshan-buyi/第十章",
   "snippet": "忌神不能克用神者有七。此忌神者乃無力之忌神也，諸占化凶爲吉。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 8,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/zengshan-buyi/第十章",
   "snippet": "倘若用神無根謂之元神有力亦難生，忌神無力何足喜。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 9,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/zengshan-buyi/第十三章",
   "snippet": "受此處之克，得他處之生，卽爲克處逢生。大凡用神、元神克少生多爲吉。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 10,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/zengshan-buyi/第十六章",
   "snippet": "月將卽是月建又爲月令。掌一月之權，司三旬之令。月將乃當權之帥，萬卜以之爲綱領。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 11,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/zengshan-buyi/第十六章",
   "snippet": "月建沖爻卽爲月破，乃無用之爻也。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 12,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/zengshan-buyi/第十六章",
   "snippet": "月建合爻爲月合，乃有用之爻也。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 13,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/zengshan-buyi/第十六章",
   "snippet": "爻之衰弱者能生之合之、比之、拱之、扶之，衰而亦旺。爻之彊旺者能沖之克之、刑之、破之，旺而亦衰。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 14,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/zengshan-buyi/第二十章",
   "snippet": "相沖之法有六。日月沖爻者一也，卦逢六沖二也，六合卦變六沖三也，沖變六沖四也。動爻變沖五也、爻與爻沖六也。沖者散也。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 15,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/zengshan-buyi/第二十章",
   "snippet": "子午相沖、丑未相沖、寅申相沖、卯酉相沖、辰戌相沖、巳亥相沖。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 16,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/zengshan-buyi/第十五章",
   "snippet": "卦有動爻，動而必變，夫變出之爻能生克沖合本位之動爻，不能生克他爻，而他爻與本位之動爻，亦不能生克變爻。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 17,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/zengshan-buyi/第二十五章",
   "snippet": "卦變者內外動而反伏者同一卦也。如乾卦變坤卦。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 18,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/zengshan-buyi/第十八章",

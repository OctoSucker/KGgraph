 "evidence": [
  {
   "edge_id": 1,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/wuxing-dayi/卷4",
   "snippet": "陰陽各六。合有十二。陽六爲律。陰六爲呂。律六者。黃鍾。大蔟。姑洗。蕤賓。夷則。無射也。呂六者。林鐘。南呂。應鐘。大呂。夾鐘。仲呂也。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 2,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/wuxing-dayi/卷4",
   "snippet": "七者。數有七也。凡有三解。一云。日月五星。合爲七政。二云。北斗七星爲七政。三云。二十八宿。布在四方。方別七宿。共爲七政。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 3,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/wuxing-dayi/卷5",
   "snippet": "高辛氏立。五行名官。以勾芒爲木正。祝融爲火正。蓐收爲金正。玄冥爲水正。后土爲土正。分掌其職。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 4,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/wuxing-dayi/卷5",
   "snippet": "東海神名勾芒。春之月。其神勾芒。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 6,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/wuxing-dayi/卷5",
   "snippet": "南海神名祝融。夏之月。其神祝融。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 8,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/wuxing-dayi/卷5",
   "snippet": "中央土。其神后土。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 10,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/wuxing-dayi/卷5",
   "snippet": "西海神名蓐收。秋之月。其神蓐收。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 12,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/wuxing-dayi/卷5",
   "snippet": "北海神名玄冥。冬之月。其神玄冥。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 14,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/wuxing-dayi/卷5",
   "snippet": "東方青帝。靈威仰。木帝也。南方赤帝。赤熛怒。火帝也。中央黃帝。含樞紐。土帝也。西方白帝。白招拒。金帝也。北方黑帝。叶光紀。水帝也。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 15,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/wuxing-dayi/卷5",
   "snippet": "東方青帝。靈威仰。木帝也。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 17,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/wuxing-dayi/卷5",
   "snippet": "南方赤帝。赤熛怒。火帝也。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 19,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/wuxing-dayi/卷5",
   "snippet": "中央黃帝。含樞紐。土帝也。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 21,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/wuxing-dayi/卷5",
   "snippet": "西方白帝。白招拒。金帝也。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 23,

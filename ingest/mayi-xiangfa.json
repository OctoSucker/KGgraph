 "evidence": [
  {
   "edge_id": 1,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/mayi-xiangfa/论形",
   "snippet": "人秉陰陽之氣，肖天地之形，受五行之資，為萬物之靈者也。故頭象天，足象地，眼象日月，聲音象雷霆，血脈象江河，骨節象金石，鼻額象山岳，毫發象草木。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 2,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/mayi-xiangfa/论神",
   "snippet": "夫形以養血，血以養氣，氣以養神，故形全則血全，血全則氣全，氣全則神全。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 3,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/mayi-xiangfa/论神",
   "snippet": "眼明則神清，眼昏則神濁。清則貴，濁則賤。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 4,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/mayi-xiangfa/论声",
   "snippet": "器大則聲宏，器小則聲短。神清則氣和、氣和則聲潤，深而圓暢也。貴人之聲，多出於丹田之中。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 5,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/mayi-xiangfa/论气",
   "snippet": "神完則氣寬，神安則氣靜。得失不足以暴其氣，喜怒不足以驚其神。則於德為有容，於量為有度，乃重厚有福之人也。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 6,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/mayi-xiangfa/论面",
   "snippet": "故五岳四瀆欲得相朝，三停諸部欲得豐滿也，貌端神靜氣和者乃富貴之基也。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 7,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/mayi-xiangfa/论面",
   "snippet": "若面色赤爆如火者，命短卒亡。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 8,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/mayi-xiangfa/论眉",
   "snippet": "眉是人倫紫氣星，稜高疏淡秀兼清。眉毛適宜長得又細又平又闊，眉毛長得秀氣而長的，主其人聰明。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 9,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/mayi-xiangfa/论上停吉气",
   "snippet": "三停諸部欲得豐滿。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 10,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/mayi-xiangfa/论上停吉气",
   "snippet": "離位為官祿之宮，橫連坤巽，宜高廣而有角。額為南方離位。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 11,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/mayi-xiangfa/论上停吉气",
   "snippet": "赤主口舌爭訟，白主喪服折傷，青主憂驚，黑主牢獄死亡。",
   "supports": true,
   "weight": 1.0
  }
 ]

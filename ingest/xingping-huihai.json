 ],
 "evidence": [
  {
   "edge_id": 1,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/xingping-huihai/卷首",
   "snippet": "独守一宫，则专其权，众星为之辅。若科甲星同宫，则被其辉，其行一年一周天。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 2,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/xingping-huihai/卷首",
   "snippet": "释云：月者，太阴之精，人臣之象，母之所配，有慈梁之义，亦为已身。其行二十九日，与日郊会，而一周天。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 3,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/xingping-huihai/卷首",
   "snippet": "释云：木主仁，名岁星。顺行则吉，逆则为长丧星，主天折。留则为灾殃屋，非为生灾病，还主官非破晦。入伏，号为栏杆星，善恶都不管，主诸事平平而已。十二年行一周天。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 4,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/xingping-huihai/卷首",
   "snippet": "诗曰：火乃离明荧惑星，伏时天坎疫瘟兴。入留别号天虹地，回禄频频家宅惊。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 5,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/xingping-huihai/卷首",
   "snippet": "紫微此星入命限，主近贵，能压凶神。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 6,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/xingping-huihai/卷一",
   "snippet": "太阳宫起生时，顺数至卯止，即是命宫。盖命禀于有生之初，脱母胎而得乎年月日时之令，则视太阳过宫，而安命缠度也。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 7,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/xingping-huihai/卷一",
   "snippet": "太阴宫起生时，逆数至酉止，即是身宫。盖太阴象母，而月出于酉，故身必数至酉而安也。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 8,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/xingping-huihai/卷一",
   "snippet": "本主月前三位是胎，假如已巳月申上是也。天干即前一位是，数至庚申，乃是胎也。盖胎元乃天地洪蒙之气初也，故不可不观此宫之主星",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 9,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/xingping-huihai/卷一",
   "snippet": "古本掌上略诀：命宫起十五、二十五、三十六、五十一、五十九、六十七、七十八、八十一。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 10,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/xingping-huihai/卷一",
   "snippet": "此法以安命宫起子逆行，---年一位，遇流年太岁住处，即是小限，管一年之祸福。遇吉星、禄马、贵人、福德、田财、高强宫，一年吉利。遇恶煞、弱冲、破耗宫，年不利。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 11,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/xingping-huihai/卷一",
   "snippet": "其法从流年小限上起生月，一月一位，月限管一月之祸福。遇吉则吉，遇凶则凶。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 12,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/xingping-huihai/卷一",
   "snippet": "命主坐实逢生，高强之地，-世荣华，更得贵格分明，必主富贵。若居因陷衰弱之宫，一生贫苦",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 13,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/xingping-huihai/卷一",
   "snippet": "恩居恩地喜非常，若在仇乡富不长。福禄二垣无恶搅，限行至此庆难量。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 14,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/xingping-huihai/卷一",
   "snippet": "难居难地事如何，大限行来灾病多。若在陷中并用地，纵然填吊得平过。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 15,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/xingping-huihai/卷一",
   "snippet": "财主归垣古石崇，重空无实范丹同。若教飞出为恩用，定主囊箱晚景丰。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 16,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/xingping-huihai/卷二",
   "snippet": "一宫宫主者，谓子丑宫(土),寅亥宫(木),卯戌宫(火),辰酉宫(金),已申宫(水),午官(日),未官(月)。此即天星也，又名星辰。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 17,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/xingping-huihai/卷二",
   "snippet": "二宫度主者，谓角斗奎井度(木),氐女胃柳度(土),房虚昴星度(日),心危毕张度(月),尾室觜翼度(火),箕壁参轸度(水),亢牛娄鬼度(金)。此即地煞也，又名地曜。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 18,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/xingping-huihai/卷二",
   "snippet": "五宫强宫者，谓命宫、官禄、田宅、妻妾、男女、福德、财帛。又云(财帛次弱，与其命宫相违故耳。居强宫者旺。六宫弱宫者，谓兄弟、奴仆、疾厄、相貌、迁移。又云：迁移近强，与其命宫相向故也。临弱宫者衰。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 19,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/xingping-huihai/卷二",
   "snippet": "九宫生者，相生也。谓木生火，火生土，土生金，金生水，水生木，如身命、官福、田财、妻嗣等星。须是他来生我者吉。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 20,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/xingping-huihai/卷二",
   "snippet": "十宫克者，相克也。谓木克土，土克水，水克火，火克金，金克木，如身命、官福、旧财、妻嗣等主。切忌他来克我者也。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 21,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/xingping-huihai/卷二",
   "snippet": "昼生日木土为奇，夜反孤星非所宜。月火金星为夜曜，日光晦昧克妻儿。释云：昼生者，喜太阳木土气计水孛于阳宫阳度；夜生者，爱太阴火金罗于阴宫阴度。如合此者，则福禄崇高，显贵论之。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 22,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/xingping-huihai/卷二",
   "snippet": "又有相克前后之分，如土在井，水在毕，为祸轻；如土在毕，水在井，则祸重。大抵生我之星宜在后，克我之星宜在前。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 23,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/xingping-huihai/卷三",
   "snippet": "宾主相和，则名扬四海，财星会辅，而富集全家。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 24,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/xingping-huihai/卷三",
   "snippet": "命弱限强，发成无久。命强限弱，终不荣超。经云：命强限弱，如逆艇上滩，命弱限强、如枯苗之通时雨，岂有不荣之理也。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 25,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/xingping-huihai/卷三",
   "snippet": "经云：“福禄主星入命来，身居禄德亦无灾。命主若还居福德，少年富贵入三台。”",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 26,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/xingping-huihai/卷三",
   "snippet": "经云：“人生官禄最为强，身命逢之大吉昌，最忌他强而我弱，多灾坎坷有灾殃。”",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 27,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/xingping-huihai/卷四",
   "snippet": "凡流年祸福，必从当生祸福为究，止以命宫为定，方判吉凶。且如一般行限，一般流年星辰到而祸福并不同者，何也?必须先看身命限度，当生有无吉凶星守照，方可言之。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 28,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/xingping-huihai/卷四",
   "snippet": "太岁为诸神之统领，月将为众煞之权衡。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 29,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/xingping-huihai/卷四",
   "snippet": "平生成败，只缘身命有亏。祸福依稀，盖是恩仇混杂，身命入恩，发达逢时。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 30,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/xingping-huihai/卷四",
   "snippet": "本无生克制化之星，而宿度有生克制化之曜者，如木坐火度，则来生火，火在木度，则受木生，如火坐金度，则来克金，如金在火度，则金受克，所谓恩度恩通，仇度仇达是也。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 31,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/xingping-huihai/卷四",
   "snippet": "假如命坐巳，以水为主，诸宫皆作水论，以金为恩，逢恩为吉。若金星在命宫，则断受福在财帛，则货财充足",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 32,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/xingping-huihai/卷四",
   "snippet": "凡命中合一二格者，不贵必然大富。合三四格者，非六卿之职即郎官之位，合五六格者非公侯即宰相之命也。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 33,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/xingping-huihai/卷四",
   "snippet": "凡命中犯忌格者，有救则吉，无救则凶。犯一二格者，非贫则夭，非夭则贫。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 34,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/xingping-huihai/卷五",
   "snippet": "命宫，官禄，妻妾，田宅高强，男女次强，福德，财帛，近强。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 35,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/xingping-huihai/卷五",
   "snippet": "相貌，奴仆，为陷害。兄弟，为闭极半陷。疾厄，为恶弱。迁移。为次弱。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 36,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/xingping-huihai/卷五",
   "snippet": "甲子乙丑海中金。以子属水，又为湖，义为水旺之地。兼金死于子，墓于丑，水旺而金死墓，故曰海中金也。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 37,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/xingping-huihai/卷五",
   "snippet": "春关牛与蛇，夏生龙猴嗟。秋忌羊猪位，冬犬虎郊加。忌两位全，只一位不为关，名两头关闭也。人命逢之，有始无终。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 38,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/xingping-huihai/卷五",
   "snippet": "子平曰：先推胎息之由，次断变通之理，精命者，不可不用此。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 39,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/xingping-huihai/卷六",
   "snippet": "甲已之年丙作首，乙庚之岁戊为头。丙辛之岁从庚上，丁壬壬位顺行流。更有戊癸何方觅，甲寅之上好追求。假如甲己年，从寅起丙顺行，乃正月建丙寅，二月丁卯是也。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 40,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/xingping-huihai/卷六",
   "snippet": "甲已还加甲，乙庚丙作初。丙辛从戊起，丁壬庚子居。戊癸何方发，王子是真途。假如甲己日，且时生人，从子上起甲子时顺行，丑上是乙丑时。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 41,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/xingping-huihai/卷六",
   "snippet": "运论节候顺未来，逆寻过去方折除。三朝成岁余加减，二添一弃月上追。阳男阴女皆顺走，阳女阴男并逆推。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 42,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/xingping-huihai/卷六",
   "snippet": "小运一诀本由时，阳男阴女顺相宜。阴男阳女随逆转，-位一岁不差移。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 43,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/xingping-huihai/卷六",
   "snippet": "当生者旺。春木、夏火、秋金、冬水。所生者相。春火、夏土、秋水、冬木。生我者休。春水、夏木、秋土、冬金。克我者囚。春金、夏水、秋木、冬土。我克者死。春土、夏金、秋水、冬火。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 44,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/xingping-huihai/卷六",
   "snippet": "子午相冲，丑未相冲，寅申相冲。卯酉相冲，辰戌相冲，巳亥相冲。相冲为凶，但有逢合，则不能冲。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 45,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/xingping-huihai/卷六",
   "snippet": "子与丑合，土。寅与亥合，木。卯与戌合，火。辰与酉合，金。巳与申合，水。午与未合，太阳、太阴。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 46,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/xingping-huihai/卷六",
   "snippet": "甲与己合，化土。乙与庚合，化金。丙与辛合，化水。丁与壬合，化木。戊与癸合，化火。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 47,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/xingping-huihai/卷六",
   "snippet": "子宫壬癸水，丑己癸辛同。寅宫戊甲丙，卯宫乙木藏。辰宫乙癸戊，巳内丙戊庚。午宫丁己土，未宫乙己丁。申内壬庚戊，酉内独辛金。戌里辛丁戊，亥宫壬甲木。地支所藏，谓之人元。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 48,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/xingping-huihai/卷六",
   "snippet": "看命先须看日主，八字始能究奥理。假如子上十日壬，中旬下旬方是癸。丑宫九日癸之余，除却三辛皆属已。寅宫戊丙各七朝，十六甲木方堪器。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 49,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/xingping-huihai/卷六",
   "snippet": "立春念三丙火用，余日甲木旺提纲。惊蛰乙木未用事，春分乙木正相当。清明乙木十日管，后来八日癸水洋。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 50,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/xingping-huihai/卷六",
   "snippet": "议者切不可恃生旺而言吉，衰败而言凶。义当以活法推之。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 51,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/xingping-huihai/卷七",
   "snippet": "凡取运以十年为一运，如甲子月生，即行乙丑十年之顺运，行癸亥，乃十年之逆运。阳顺阴逆，女命反此，是理之正也。时师则以上下五年之分，此乃惑人之甚，何其谬哉。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 52,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/xingping-huihai/卷七",
   "snippet": "是必先观气象规模，乃富贵贫穷之纲领。次论用神出处，尽死生穷达之精微。气象规模者，八字之格局。格局清高，得其旺相均匀，勿使太过不及，则富贵可知。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 53,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/xingping-huihai/卷七",
   "snippet": "不须八字繁华，只要五行和气。繁华者，乃五行得时，和气者，勿使相伤相克，有制有化之谓。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 54,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/xingping-huihai/卷七",
   "snippet": "壶中子云：官轻不若煞轻，所以喜财之地，生官克印，表里方得中和，方可发福。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 55,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/xingping-huihai/卷七",
   "snippet": "用财不有煞重来，羊刃逢之必夺财。再到刃乡应破局，伤妻败业见非灾。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 56,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/xingping-huihai/卷七",
   "snippet": "印乃清高正大之物，见财则不能保其名位。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 57,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/xingping-huihai/卷七",
   "snippet": "欲知贵贱，先观月令乃提纲。月令乃八字之纲领，更知节气之深浅，以知祸福。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 58,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/xingping-huihai/卷七",
   "snippet": "用神不可损伤，日主最宜健旺。如月令有官不可伤，有财不可损，有印不可破。凡柱中有用之神，不可损害也。仍要日干强健，则能任其财官。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 59,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/xingping-huihai/卷八",
   "snippet": "女命以柔为本，以刚为刑，以清为奇，以浊为贱。然三奇得位，良人万里封侯。二德归垣，贵子九秋步月。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 60,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/xingping-huihai/卷八",
   "snippet": "欲推女命，先看官星。官带煞而贫贱，官得令以安荣。伤官太重必妨夫，且是为人性重。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 61,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/xingping-huihai/卷八",
   "snippet": "官多无官，太旺倾危。煞多无煞；反为不害。财多无财，运逢化煞为灾。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 62,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/xingping-huihai/卷八",
   "snippet": "五行克战，非伤日主不为灾。岁运并临，若损用神皆有祸。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 63,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/xingping-huihai/卷八",
   "snippet": "水火有既济之功.金木有成名之论。五行得其相济，威名荣振九天。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 64,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/xingping-huihai/卷八",
   "snippet": "食神生旺，胜似财官，贵全官杀。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 65,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/xingping-huihai/卷九",
   "snippet": "甲乃阳木无根，若无水则枯朽矣，不可雕琢也。癸水，阴水也。犹石泉地中之脉，不泛不浮。甲木赖之以滋身，方得荣茂，而可以活生。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 66,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/xingping-huihai/卷九",
   "snippet": "子平云：用之为官不可冲，用之为禄不可破。破而冲之，两相为害。虽有威权，遇之则避身退位矣。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 67,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/xingping-huihai/卷九",
   "snippet": "丙火遇水会局，则有伤害之谓，若不会局亦无害也。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 68,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/xingping-huihai/卷九",
   "snippet": "刑者，寅刑巳，已刑申，申刑寅。又丑府戌，辰刑未，子刑卯，卯刑子也。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 69,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/xingping-huihai/卷十",
   "snippet": "五行提纲凡看命排下八字，以日干为主，取年为根，为上祖财产，知世派之盛衰。取月为苗，为父母，则知亲荫之有无。日干为己身，日支为妻妾，则知妻妾之贤淑。时为花实，为子息，方知嗣续之所归。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 70,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/xingping-huihai/卷十",
   "snippet": "大凡取格，要如神见，斟酌轻重之理，专以日干为主，配合月令。看六事财官，印伤食煞，俱清奇，为福贵人也。最忌四柱刑冲破害，须看月令深浅，秉令金木水火土，五行之理取也。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 71,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/xingping-huihai/卷十",
   "snippet": "以日为主本，而取提纲为用，次年月日时为实，逢官看财，逢财看煞，逢煞看印，逢印看官。歌云：官二印三财位，四煞五食六伤官。立法先详生与死，次分贵贱吉凶看",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 72,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/xingping-huihai/卷十",
   "snippet": "夫正官者，六格之正气。忠信之尊名，虽治国齐家之道，只喜一位。多则论煞，不宜入格。惟月内有官星者为正。时上兼有财星者，真贵人也。但怕冲，忌见伤官七煞。大运亦然，喜印绶，喜身旺，喜财星，岁运同。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 73,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/xingping-huihai/卷十",
   "snippet": "夫偏官者，即七煞有制，谓之偏官也。若有偏印偏财，身煞两享，则为大富贵之命也。若逢制神太过，官煞混杂之地，则去官退职，多致凶死。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 74,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/xingping-huihai/卷十",
   "snippet": "夫七煞者，乃克我之神。有制在局为福，其如恶宿小人之例，须要制伏，亦可为用。大抵要身旺，比肩助之亦喜，印绶见之为妙。如见制伏太过，则反无根，必须得其中和而取。如煞重身轻，喜行身旺运。如身强煞浅，喜行煞旺运。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 75,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/xingping-huihai/卷十",
   "snippet": "夫印绶之格，四柱喜见官星七煞，及运行官煞，身旺为福。大忌柱中，财伤印绶，如行运去便发。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 76,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/xingping-huihai/卷十",
   "snippet": "财神宜藏，藏则丰厚。露则浮荡，用财不喜比肩。运行比劫分财，惟恐命元伤尽。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 77,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/xingping-huihai/卷十",
   "snippet": "食神惟提纲有者要身旺，食神旺有财星。四柱忌印绶官煞，比肩羊刃为祸。大忌刑冲破害，最喜生盯。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 78,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/xingping-huihai/卷十",
   "snippet": "伤官务要伤尽，伤之不尽，官来乘旺，其祸不可言。伤官见官，为祸百端，如月令在伤官之位，及四柱次合，作事皆在伤官之处。又行身旺乡，真贵人也。人命带伤官多，有财星。或行身旺运，或行财旺运，发福富贵之论也。身旺无财者凶，若一逢官运，必然见祸，宜退身避职，病不死者有之。凡伤官只喜财及身旺，若行财衰及死绝之地；脱财无禄，非官词讼败散，丧病死期至矣。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 79,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/xingping-huihai/卷十",
   "snippet": "夫煞印者，日干原弱，亦遇多煞无制，全赖印绶滋身化煞。或有羊刃帮助，乃为大贵之命，煞旺财旺破印，助起凶而不吉。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 80,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/xingping-huihai/卷十",
   "snippet": "夫时墓之论，谓财官入库之谓也。要刑冲破害，以开局钥，其人必发。经曰：少年不发墓中人也。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 81,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/xingping-huihai/卷十",
   "snippet": "独羊刃以时言之，四柱中不要入财乡，最怕冲羊刃。如戊日在午，忌行子地正财之地，壬日刃在子，忌行午地，乃正财之运。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 82,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/xingping-huihai/卷十",
   "snippet": "辰多好斗，戌多好讼。辰戌魁罡，多凶少吉。",
   "supports": true,
   "weight": 1.0
  },

 "evidence": [
  {
   "edge_id": 1,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/shenfeng-tongkao/病药说类",
   "snippet": "何以為之病？原八字中原所害之神也；何以為之藥？如八字原有所害之字，而得一字以去之謂了。故書云：有病方為貴，無傷不是奇；格中如去病，財祿兩相隨。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 2,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/shenfeng-tongkao/病药说类",
   "snippet": "如八字原有所害之字，而得一字以去之謂了，如朱子所謂各因其病而藥之也。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 3,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/shenfeng-tongkao/病药说类",
   "snippet": "四柱纯土水，日干为杀重身轻；如金日干则为土厚埋金；俱喜木为医药以去其病。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 4,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/shenfeng-tongkao/病药说类",
   "snippet": "用财见比肩为病，喜见官杀为药。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 5,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/shenfeng-tongkao/病药说类",
   "snippet": "用食神伤官，以印为病，喜财为药。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 6,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/shenfeng-tongkao/叙",
   "snippet": "立五星正說，五星謬說，子平諸格正說，子平諸格謬說，動靜說，蓋頭說，六親說，病藥說，雕枯弱旺損益生長八法說。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 7,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/shenfeng-tongkao/偏官",
   "snippet": "凡看命先看七殺，若有七殺，就要將此七殺處置了，方能用得別物。原書去云：有殺須論殺，無殺方論用。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 8,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/shenfeng-tongkao/偏官",
   "snippet": "偏官即七殺也，如甲日干，數至七個字逢庚字，號為七殺，乃克身之刀劍一般，偏官無制曰七殺，故宜制伏，亦畏太過，亦畏不及。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 9,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/shenfeng-tongkao/偏官",
   "snippet": "棄命從殺格，緣日主全無一點生氣，四柱純然有官殺，則不得已而只得從殺也。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 10,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/shenfeng-tongkao/正官",
   "snippet": "大抵用月上官星，要官旺，官旺方好取用。要官星有病，各因病而藥之，官旺官多，喜食神以制去之，官星氣弱，喜財神以生之。",
   "supports": true,
   "weight": 1.0
  }
 ]

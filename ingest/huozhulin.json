 "evidence": [
  {
   "edge_id": 1,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/huozhulin/易中明义",
   "snippet": "四营成易，八卦为体；三才变化，六爻为义。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 2,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/huozhulin/六亲根源",
   "snippet": "卦定根源，六亲为主；又究旁通，五行而取。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 3,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/huozhulin/六亲根源",
   "snippet": "父母、兄弟、妻财、子孙、官鬼，只有五件，而曰六亲何也？答曰：卦身当一亲。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 4,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/huozhulin/六亲根源",
   "snippet": "阳世则从子月起，阴世还当午月生，此即卦身也。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 5,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/huozhulin/六亲根源",
   "snippet": "本宫之六亲在飞象之下，为之亲王，为之伏神。旁宫之飞象加伏神之上，为飞象。知飞伏二爻之来历，然后可与言八卦、六亲矣。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 6,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/huozhulin/出现伏藏",
   "snippet": "出现旺相，为久为远；伏藏有气，只利暂时。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 7,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/huozhulin/独发乱动",
   "snippet": "乱动之卦只取旺爻，旺爻即用神也。生克吉凶皆在此爻。若伏藏安静要旺相，若发动，却要生世之爻为用神。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 8,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/huozhulin/公私用事",
   "snippet": "官用取官，私用取财。占病鬼祟，占失看贼，占求官事，占官词讼，占婚问夫，以上皆看官爻。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 9,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/huozhulin/公私用事",
   "snippet": "占买卖财，占家事，占婚婢事，占求财事，占婚姻事，以上皆看财爻。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 10,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/huozhulin/世应相克",
   "snippet": "占财要财爻持世，占官要官爻持世，若应又是世之墓，动又是世之墓，皆不中矣。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 12,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/huozhulin/财官辅助",
   "snippet": "财官异路，可辨五乡；用有辅助，类可忖量。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 13,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/huozhulin/公私用事",
   "snippet": "占官必用父母，占财必用子孙。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 14,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/huozhulin/公私用事",
   "snippet": "占官必用父母，占财必用子孙。兄弟是破财之人，不为主、不为辅。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 15,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/huozhulin/易中明义",
   "snippet": "六十甲子生成，变化而行鬼神，是故天干管天文，地支管人事，纳音管地理。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 16,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/huozhulin/财官辅助",
   "snippet": "春，寅卯木旺，巳午火相，亥子水休，申酉金囚，辰戌丑未土死。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 17,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/huozhulin/财官辅助",
   "snippet": "夏，巳午火旺，辰戌丑未土相，寅卯木休，亥子水囚，申酉金死。",
   "supports": true,
   "weight": 1.0

  {
   "edge_id": 13,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/ziwei-doushu/卷一",
   "snippet": "紫微屬土。中天之尊星为帝座，主掌造化枢机，人生主宰。诸宫降福能消百恶。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 15,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/ziwei-doushu/卷一",
   "snippet": "天机屬木。南斗第三益算之善星，化气曰善，解诸星之顺逆。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 17,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/ziwei-doushu/卷一",
   "snippet": "太阳屬火。日之精也，主人有贵气，能为文为武，乃官禄之枢机。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 19,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/ziwei-doushu/卷一",
   "snippet": "武曲屬金。北斗第六星，乃财帛宫主。性刚果决，在天司寿，在数司财。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 21,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/ziwei-doushu/卷一",
   "snippet": "天同屬水。南方第四星，为福德宫之主宰，化福，十二宫中皆曰福。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 23,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/ziwei-doushu/卷一",
   "snippet": "廉贞屬火。北斗第五星，在斗司品秩，在数司权令，化囚为杀。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 25,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/ziwei-doushu/卷一",
   "snippet": "天府屬土。南斗主令第一星，为财帛之主宰，司命延寿解厄。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 27,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/ziwei-doushu/卷一",
   "snippet": "太阴屬水。水之精，为田宅主，化富，与日为配。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 29,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/ziwei-doushu/卷一",
   "snippet": "贪狼屬水。北斗解厄之神第一星，化气为桃花，主祸福。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 31,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/ziwei-doushu/卷一",
   "snippet": "巨门屬水。北斗第二星，为阴精之星，化气为暗，主口舌是非。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 32,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/ziwei-doushu/卷一",
   "snippet": "巨门屬金。北斗第二星，为阴精之星，化气为暗，主口舌是非。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 34,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/ziwei-doushu/卷一",
   "snippet": "天相屬水。南斗第五星，为司爵之宿，化气曰印，官禄文星。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 36,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/ziwei-doushu/卷一",
   "snippet": "天梁屬土。南斗第二星，司寿化气为荫为福寿，化暴戾为祥和。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 38,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/ziwei-doushu/卷一",
   "snippet": "七杀屬火。南斗第六星，斗中上将，成败之孤辰，主风宪。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 39,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/ziwei-doushu/卷一",
   "snippet": "七杀屬金。南斗第六星，斗中上将，成败之孤辰，主风宪。",

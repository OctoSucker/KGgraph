 ],
 "evidence": [
  {
   "edge_id": 1,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/ditian-sui/01",
   "snippet": "天有阴阳，故春木，夏火，秋金，冬水，季土。得时而显其神功，命中天地元之理，悉本于此，日干为天元，地支为地元，支中所为人元。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 2,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/ditian-sui/02",
   "snippet": "甲为根干之木，纯阳之本，参天雄壮，火者，木之子也，旺木得火而愈敷荣，生于春，则助火而不能容金也，生于秋则助金而不能容土也",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 3,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/ditian-sui/02",
   "snippet": "乙为枝叶之木，柔如花卉，然坐丑未能制之，（丑未阴土，故乙能制。）如宰羊割牛，只要有一丙丁，则虽申酉之月，亦不畏怯",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 4,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/ditian-sui/02",
   "snippet": "丙为焚烈之火，纯阳之性，故不畏秋而欺霜，不畏冬而侮雪，庚金虽顽，力能煆之，辛金虽柔，合而反弱",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 5,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/ditian-sui/02",
   "snippet": "至丙遂炎上之性，而寅午戌更露甲木，（身旺遇印）则燥而焚灭也。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 6,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/ditian-sui/02",
   "snippet": "丁为温煖之火，其性虽烈而属阴，则柔而得其中矣，外柔顺而内文明，岂不昭融乎",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 7,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/ditian-sui/02",
   "snippet": "戊为山冈之土，非城墙之谓，较己土特高厚刚燥，乃己土之发源地也，得乎中气，而且正，大春夏则气辟而生万物，秋冬则气翕而成万物，故为司命，其气属阳，喜润下恶燥，坐寅怕申，坐申怕寅",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 8,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/ditian-sui/02",
   "snippet": "己为田园之土，其性卑湿，乃戊土枝叶之地，亦主中正，蓄藏万物，柔土能生木，非木所能克，故不愁木盛，土深能纳水，非水所能荡，故不畏水旺",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 9,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/ditian-sui/02",
   "snippet": "庚乃阳金，是太白之精，带煞而刚健，健而得水，则气流而清，刚而得火，则气纯而粹",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 10,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/ditian-sui/02",
   "snippet": "辛金生于冬月，见丙则男命不贵，（丙辛合而化水）虽贵亦不忠，女命克夫，不克亦不和，若见丁则男女皆贵且顺。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 11,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/ditian-sui/02",
   "snippet": "壬乃癸水之源，有分有合，运行不息，为百川，亦为雨露，不可岐而二之，壬水能泄西方金气，其德刚中而又周流不滞，若遇申子辰，而又透癸，则其势不可遏也",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 12,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/ditian-sui/02",
   "snippet": "癸乃纯阴而至弱，然上达天津，凡柱中有甲乙寅卯，皆能运用水气，生木制火，润土养金，如龙能运水，火土虽多不畏，至于庚辛，则不赖其生，亦不忌其多，惟合戊化火，必通火根，乃为真也。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 13,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/ditian-sui/03",
   "snippet": "子，寅，辰，午，申，戌，阳也，其性动，其势强，其发至速，其灾祥至显。丑，卯，巳，未，酉，亥，阴也。其性静，其气专，其否泰之验，每经年而始见。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 14,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/ditian-sui/03",
   "snippet": "寅申巳亥，四生也；忌冲动。辰戌丑未，四库也；宜冲开。子午卯酉，四败也，有逄合而喜冲者，不若生地之必不可冲也；有逄冲而喜合者，不若库地之必不可闭也",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 15,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/ditian-sui/03",
   "snippet": "子旺午衰，则午因冲而本拔，子衰午旺，则午因冲而发福，余倣此。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 16,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/ditian-sui/04",
   "snippet": "形全者宜损其有余，形缺者宜补其不足。如甲木生于寅卯辰月，丙火生于巳午未月，皆为形全。戊土生于寅卯辰月，庚金生于巳午未月，皆为形缺",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 17,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/ditian-sui/05",
   "snippet": "如寅卯辰全，而又干透甲乙一元神，复又遇亥之生，未之库，决不发福，方不可混以局也。如甲乙日遇亥卯未全，而又干透庚辛一官星，又见右寅，左辰，则名利无成，局不可混以方也",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 18,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/ditian-sui/06",
   "snippet": "格之真者，月支之神，透于天干也，(格局看月支要紧)以散乱之天干，而寻其得所附于提纲者，非格也",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 19,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/ditian-sui/06",
   "snippet": "煞，即官也。同流同止，可混也。官非煞也，各立门庭，不可混也，煞重矣，官从之，非混也。官轻矣，煞助之，即混也。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 20,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/ditian-sui/07",
   "snippet": "日主孤弱无气，天地人三元，绝无一毫生扶之意，财官等强甚，乃为真从也，既从矣，当论所从之神",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 21,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/ditian-sui/07",
   "snippet": "如甲日主，生于四季，单遇一位己土，在月时上作合，（在年干不是）不遇壬癸甲乙庚（印，劫，官），乃为化得真，（庚能克甲）又如丙辛生于冬月，（化神要通月令）戊癸生于夏月，乙庚生于秋月，丁壬生于春月，独相作合，皆为真化",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 22,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/ditian-sui/08",
   "snippet": "日主弱矣，财官强矣，不能不从，中有所助者，便假，至于行运，财官得地，虽是假从，亦可富贵，但其人不能免祸，或心术不端耳。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 23,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/ditian-sui/10",
   "snippet": "有以日主为体，提纲之食神财官，皆为我用。日主弱，则提纲有物帮身，以制其强神者，亦皆为我用。有以提纲为体，喜神为用者，日主不能用乎提纲矣。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 24,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/ditian-sui/12",
   "snippet": "旺则宜泄宜伤，衰则喜帮喜助，子平之理也，然旺中有衰者存，不可损也。衰中有旺者存，不可益也。旺之极者不可损，以损在其中矣，衰之极者不可益，以在其中矣。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 25,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/ditian-sui/13",
   "snippet": "中而且和，子平之要法，虽曰有病方为贵，无伤不是奇，然毕竟云：格中如去病，财禄两相随，则又中和矣，是必归于中和，乃为至贵",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 26,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/ditian-sui/14",
   "snippet": "如庚辛生于七月，遇丁火而激其威，遇乙木而助其暴，遇己土而成其志，遇癸水而益其锐，不如以柔之刚者济之可也。壬水是也，盖壬水有正性，能引通庚之情故也",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 27,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/ditian-sui/16",
   "snippet": "阴支为寒，阳支为暖，金水为寒，木火为暖，得气之寒，遇暖而发，得气之暖，遇寒而成",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 28,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/ditian-sui/17",
   "snippet": "令星，乃命之至要，宜气象得令者吉，喜神得令者吉，故如人之家宅，支藏之人元，如寅中戊土丙火甲木，辨其孰为用事，则可以取格，可以取用，故如宅之向也。（如寅月生人，立春后七日前，皆值戊土用事，八日后十四日前，丙火用事，十五日后，甲木用事，知此则可以取格，可以取用矣）。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 29,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/ditian-sui/19",
   "snippet": "不必论当令不当令，以取最多旺，可为全局祖者宗为源头，看此源头，流到何方，流去之处，若是所喜之神，即在此住了为妙",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 30,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/ditian-sui/20",
   "snippet": "阴阳之气，欲和合相生，木土而得火，火金而得土，土水而得金，金木而得水，水火而得木，情本相通，若中间或被间阻，或被刑冲，或被劫占，皆为关隔，如局中及岁运，得引用会合之神，去其间阻，和其刑冲，制其劫占，乃为通关，关通则满局皆顺遂矣",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 31,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/ditian-sui/22",
   "snippet": "如木火透者，生寅月聚得真，不要金水乱之，则真神得用，不为忌神所害，必然发贵",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 32,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/ditian-sui/23",
   "snippet": "局中所喜之神，透于天干，岁运伤之，局中所忌之神，伏于地支，岁运扶之，皆为祸患，故暗用吉神则吉，如明露忌神，制化得所者亦吉。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 33,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/ditian-sui/28",
   "snippet": "天干遇甲庚，乙辛，谓之天战，而得地顺静者无害，支寅申，卯酉，谓之地战，则干不能为力，其势速凶，盖天主动，地主静故也，如庚申，甲寅，乙卯，辛酉，之类，皆见者，谓之天地交战，必凶无疑",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 34,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/ditian-sui/30",
   "snippet": "金木交争，不能缺水，水火相战，不能缺木，以水与木为调和通关之神也，如原局无水木，必须一路行水运或木运，方能弥其缺，否则，必不为吉",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 35,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/ditian-sui/27",
   "snippet": "君赖臣生理最微，儿能生母泄天机，母慈灭子关头异，夫健何为又怕妻。日干，君也，所克者，臣也。皆君赖臣生也。水泛木浮，土止水则生木。木旺火晦，金伐木则生火。火炎土焦，水克火则生土。土重埋金，木克土则生金。金旺水浊，火克金则生水。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 36,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/ditian-sui/31",
   "snippet": "日主为君，财星为臣，如甲乙日主，满盘是木，内有一二点土，是君盛臣衰，要助其臣，火生之，土实之，金卫之，（官制劫以卫财）其势要多，庶几上全而下安。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 37,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/ditian-sui/32",
   "snippet": "日主为母，所生为子（食伤）如甲乙日主，满盘是木，内有一二点火，是母旺子孤，要助其子，行火运，方有瓜瓞绵绵之庆矣。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 38,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/ditian-sui/34",
   "snippet": "五行在天，为金木水火土之气，在人为仁义礼智信之性，五气不乖张，则其存于人之性，发于外为情，莫不清和矣，反此者乖戾。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 39,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/ditian-sui/35",
   "snippet": "忌木而入土者脾病，忌火而入金则肺病，忌土而入水则肾病，忌金而入木则肝病，忌水而入火则心病。",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 40,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/ditian-sui/36",
   "snippet": "喜神不必多，一喜而众善备矣，忌神不必多，一忌而众害备矣，自喜忌之外，不必以为喜，不足以为忌者，皆闲神也",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 41,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/ditian-sui/38",
   "snippet": "大率依财看妻，如喜神即是财神，其妻美而且富贵，喜神与财神不相妒忌，亦可，否则克妻，或不美，或欠和",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 42,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/ditian-sui/38",
   "snippet": "大率依官星看子，如喜神即官星，其子贤俊，喜神与官星不相妒，亦好，否则无子，或不肖，或有克",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 43,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/ditian-sui/41",
   "snippet": "官星身旺，而印卫官，忌劫而官能制劫，喜印而官能生印，财星旺而星通达，官星旺而财神有气，无官而暗成官局，官星藏而财神亦藏，此皆官星有理会，所以贵也",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 44,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/ditian-sui/41",
   "snippet": "财旺身强，官星卫财，忌印而财能坏印，喜印而财能生官，伤官重而财神流通，财神重而伤官有限，无财而暗成财局，财露而伤官亦露，此皆财气通门户，所以富也",
   "supports": true,
   "weight": 1.0
  },
  {
   "edge_id": 45,
   "source_type": "corpus_extracted",
   "source_ref": "zhouyi-v2/gushu/ditian-sui/42",
   "snippet": "如以八字论，则年为元，月为亨，日为利，时为贞，年月吉者，前半世吉，日时吉者，后半世吉",
   "supports": true,
   "weight": 1.0
  }
 ]
}